<?xml version="1.0"?>
<ruleset name="RAN EmailOctopus for Jetpack Forms">
	<description>RAN WordPress plugin standards with repository-local support and identity policy.</description>
	<file>includes</file>
	<file>ran-emailoctopus-jetpack-forms.php</file>
	<file>tests</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Repository support policy remains local. -->
	<config name="minimum_supported_wp_version" value="6.8"/>
	<config name="testVersion" value="8.0-"/>

	<!-- Shared RAN WordPress/WPCS/PHPCompatibility ancestry. -->
	<rule ref="RANWordPressPlugin"/>

	<!-- Repository identity remains local. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ran-emailoctopus-jetpack-forms"/>
			</property>
		</properties>
	</rule>
</ruleset>